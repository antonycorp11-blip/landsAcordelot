# Save na nuvem (opcional). Sem estas duas linhas o jogo roda 100% local.
#
# Copie para .env.local e preencha com os valores do seu projeto Supabase,
# em Project Settings > API. Os dois são públicos por natureza: a chave anon
# foi feita para ir no código do cliente, e quem protege os dados é o RLS.
#
# NUNCA coloque aqui a service_role. Ela ignora todas as regras de segurança.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
